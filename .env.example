# Copy to .env for local/manual runs (never commit the real .env).
# In production this project reads these from GitHub Actions
# Secrets/Variables instead — see docs/SETUP.md.

# --- eBay Developer Program (docs/SETUP.md step 1) ---
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ENV=PRODUCTION
# 20675 = Mugs. Verify with the Taxonomy API before changing product.
EBAY_CATEGORY_ID=20675

# --- eBay Business Policies (Seller Hub > Account > Business Policies) ---
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# --- Printify (docs/SETUP.md step 2) ---
# Defaults below are the 11oz white ceramic mug; leave blank to use them.
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=
PRINTIFY_BLUEPRINT_ID=478
PRINTIFY_PRINT_PROVIDER_ID=99
PRINTIFY_VARIANT_IDS=65216

# --- GitHub (only needed for local testing of issue creation) ---
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo

# --- Pipeline behavior ---
DAILY_LISTING_QUOTA=3
# Units offered per listing. Keep this at 1: eBay's selling limit for new
# accounts counts quantity x price across all live listings (e.g. 50 items
# / $700 a month), and print-on-demand never runs out of stock — the
# fulfillment sync restores the quantity after every sale.
LISTING_QUANTITY=1
AUTO_PUBLISH=false
DRY_RUN=false
# Sale price comes from what comparable listings actually sell for, not
# from a markup. These two are the floor the resulting economics must
# clear. Kept low on purpose right now: a new seller gets almost no
# organic visibility regardless of listing quality, so the near-term goal
# is real sales/reviews (helped along by PROMOTED_LISTINGS below) rather
# than protecting margin on them — but a listing still has to not lose
# money outright before any ad spend. Raise this once demand data (or a
# cheaper print provider) supports a healthier margin.
MIN_UNIT_PROFIT_CENTS=10
# Seller's share of shipping: 77 when the buyer pays shipping (eBay's fee
# on the shipping charge), 579 if shipping is free to the buyer.
SHIPPING_COST_CENTS=77
# Once one theme has this many published, profitable listings, research
# stops exploring the others and commits to it — see themes.py's list for
# what's being explored today.
BRAND_LOCK_MIN_PUBLISHED=3
# Appended to every listing once you've picked a shop name/tagline
# (Seller Hub > Account > Business Policies is where the shop itself is
# named; this only keeps every listing consistent with it). Leave blank
# until then.
BRAND_TAGLINE=

# eBay Promoted Listings Standard (cost-per-sale ads): only charged when an
# ad click leads to an actual sale, nothing if it doesn't sell. A brand-new
# seller with zero feedback is ranked far down eBay's own search regardless
# of listing quality, so this is the practical lever for getting first
# sales/reviews. Requires the sell.marketing OAuth scope on
# EBAY_REFRESH_TOKEN — if that scope wasn't granted when you authorized,
# ad creation fails safely (the listing itself still publishes) and the
# approval-issue comment says so.
PROMOTED_LISTINGS_ENABLED=false
# eBay requires 2.0-100.0. High enough by default to plausibly absorb the
# entire per-unit margin — the point at this stage is buying first sales
# and feedback, not preserving profit on them.
PROMOTED_LISTINGS_BID_PERCENTAGE=10.0
PROMOTED_LISTINGS_CAMPAIGN_NAME=ebay-automation-cps

# --- Pinterest (docs/SETUP.md "Pinterest") ---
# App credentials from developers.pinterest.com; token key from
# `python scripts/pinterest_authorize.py newkey`. All three are secrets.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_TOKEN_KEY=
# https://api-sandbox.pinterest.com while the app only has Trial access.
PINTEREST_API_BASE=https://api.pinterest.com
PINTEREST_BOARD_NAME=Funny Coffee Mugs
PINTEREST_PINS_PER_RUN=2

# --- Japan export research (docs/SETUP.md step 6) ---
# Yahoo!ショッピング Client ID. Blank = rank genres by eBay demand only.
YAHOO_APP_ID=
EXPORT_FEE_RATE=0.1525
EXPORT_FEE_FIXED_USD_CENTS=40
EXPORT_FX_HAIRCUT=0.03
EXPORT_DOMESTIC_SHIPPING_JPY=600
# International shipping estimates incl. packing; set to your carrier's real rates.
EXPORT_SHIPPING_SMALL_JPY=2200
EXPORT_SHIPPING_MEDIUM_JPY=3800
EXPORT_SHIPPING_LARGE_JPY=6500
# true once registered as a 課税事業者 (export consumption-tax refund).
EXPORT_TAX_REFUND=false
EXPORT_MIN_PROFIT_JPY=1500
# US duty the seller prepays (Japan Post requires it since April 2026); 0 if the buyer pays at checkout.
EXPORT_SELLER_DUTY_RATE=0.15
EXPORT_DUTY_FEE_JPY=300
EXPORT_SAMPLE_SIZE=25

# --- Japan export listings (docs/SETUP.md step 7) ---
EXPORT_MERCHANT_LOCATION_KEY=jp-home
EXPORT_FULFILLMENT_POLICY_ID=
# Found by this name when the ID is blank (created by scripts/export_setup.py).
EXPORT_FULFILLMENT_POLICY_NAME=Japan export
# City level only, used once by scripts/export_setup.py.
EXPORT_LOCATION_CITY=
EXPORT_LOCATION_PREFECTURE=
EXPORT_LISTING_QUERIES=beyblade x takara tomy;beyblade x bx;beyblade x ux;tomica premium;tomica limited vintage;plarail takara tomy;tamagotchi japan
EXPORT_DAILY_LISTING_QUOTA=3
EXPORT_DAILY_PHOTO_REQUESTS=0
# Publish catalog-photo drafts without waiting for /approve.
EXPORT_AUTO_PUBLISH=true
EXPORT_UNDERCUT_USD_CENTS=50
EXPORT_HANDLING_DAYS=5
EXPORT_LISTING_SIZE=small
EXPORT_MIN_COST_RATIO=0.2
