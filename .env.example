# Copy to .env for local/manual runs (never commit the real .env).
# In production this project reads these from GitHub Actions
# Secrets/Variables instead — see docs/SETUP.md.

# --- eBay Developer Program (docs/SETUP.md step 1) ---
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ENV=PRODUCTION
# 20675 = Mugs. Verify with the Taxonomy API before changing product.
EBAY_CATEGORY_ID=20675

# --- eBay Business Policies (Seller Hub > Account > Business Policies) ---
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# --- Printify (docs/SETUP.md step 2) ---
# Defaults below are the 11oz white ceramic mug; leave blank to use them.
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=
PRINTIFY_BLUEPRINT_ID=478
PRINTIFY_PRINT_PROVIDER_ID=99
PRINTIFY_VARIANT_IDS=65216

# --- GitHub (only needed for local testing of issue creation) ---
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo

# --- Pipeline behavior ---
DAILY_LISTING_QUOTA=3
AUTO_PUBLISH=false
DRY_RUN=false
# Sale price comes from what comparable listings actually sell for, not
# from a markup. These two are the floor the resulting economics must clear.
MIN_UNIT_PROFIT_CENTS=100
SHIPPING_COST_CENTS=579
