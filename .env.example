# Copy this file to .env and fill in your own values. Never commit .env.

# Printify account settings -> Connections -> Generate a new personal access token.
PRINTIFY_API_TOKEN=

# The shop id of the store connection you created in the Printify dashboard
# (Add new store). Find it via GET https://api.printify.com/v1/shops.json
# once PRINTIFY_API_TOKEN is set, or from the dashboard URL.
PRINTIFY_SHOP_ID=

# Brand name used in product titles/descriptions/tags.
BRAND_NAME=EQUINOX

# Optional overrides - leave blank to let the script auto-pick sensible
# blueprints/providers from the live Printify catalog by keyword.
TSHIRT_BLUEPRINT_KEYWORD=Unisex Heavy Cotton Tee
STICKER_BLUEPRINT_KEYWORD=Kiss Cut Stickers
TSHIRT_BLUEPRINT_ID=
STICKER_BLUEPRINT_ID=
TSHIRT_PRINT_PROVIDER_ID=
STICKER_PRINT_PROVIDER_ID=
TSHIRT_PRICE_CENTS=2499
STICKER_PRICE_CENTS=499
TSHIRT_MAX_VARIANTS=
STICKER_MAX_VARIANTS=

# Two separate T-shirt products are created: a left-chest one-point print
# and a sleeve one-point print. Pick which sleeve the second one uses.
TSHIRT_SLEEVE_POSITION=left_sleeve

# Set these (from a previous run's printify/last_run.json, or the Printify
# dashboard URL) to update an existing draft instead of creating a new one.
TSHIRT_CHEST_PRODUCT_ID=
TSHIRT_SLEEVE_PRODUCT_ID=
STICKER_PRODUCT_ID=

# Set to "true" to publish immediately after creating the products instead
# of leaving them as drafts for manual review in the Printify dashboard.
PRINTIFY_PUBLISH=false

# Override these (--product-name / --product-tags) to reuse this script for
# a second motif/product line under the same brand/shop, e.g. a Kamon Crest
# series alongside the Aries Ram one. Give each line's own
# *_PRODUCT_ID vars (e.g. KAMON_TSHIRT_CHEST_PRODUCT_ID) so re-running
# updates the right product instead of the default Aries Ram one.
PRODUCT_NAME=Aries Ram
PRODUCT_TAGS=Aries,Ram,zodiac


# --- eBay -------------------------------------------------------------
# From developer.ebay.com -> My Account -> Application Keys (create a
# keyset). Use the Production keys once you're ready to go live, Sandbox
# keys to test against a fake marketplace first.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The "RuName" (redirect URL name) you configure for your keyset's OAuth
# redirect, from the same Application Keys page.
EBAY_RU_NAME=
# Set by exchange_code.py after the one-time browser consent flow
# (see ebay/oauth_consent.py). Valid for about 18 months.
EBAY_REFRESH_TOKEN=
EBAY_SANDBOX=false
EBAY_MARKETPLACE_ID=EBAY_US

# One-time account setup (ebay/setup_account.py) - your real ship-from
# address and policy terms. Never invented on your behalf.
EBAY_LOCATION_NAME=EQUINOX Warehouse
EBAY_LOCATION_ADDRESS_LINE1=
EBAY_LOCATION_CITY=
EBAY_LOCATION_STATE=
EBAY_LOCATION_POSTAL_CODE=
EBAY_LOCATION_COUNTRY=US
# Printify's actual print-provider handling time for the product, not a
# guess - check GET /v1/catalog/blueprints/{id}/print_providers/{id}/shipping.json
# (handling_time) for each product, since it varies per provider.
EBAY_HANDLING_DAYS=10

# eBay's fulfillment policy always needs a DOMESTIC shipping option (see
# note in setup_account.py). With Printify's print-on-demand model this is
# NOT a dummy placeholder even for a seller registered outside the US: the
# item is actually printed and shipped from the print provider's own
# facility (often US-based), so "domestic" (their country -> their
# country) is real, everyday traffic - it does not follow your own
# EBAY_LOCATION_COUNTRY above. Check the actual provider location via
# GET /v1/catalog/print_providers/{id}.json and its real shipping costs via
# the shipping.json endpoint above before setting these.
EBAY_DOMESTIC_SHIPPING_CARRIER=USPS
EBAY_DOMESTIC_SHIPPING_SERVICE=USPSParcel
EBAY_DOMESTIC_SHIPPING_COST=0.00
EBAY_DOMESTIC_ADDITIONAL_SHIPPING_COST=0.00

# Set to "false" if you only ship within the marketplace's home country.
EBAY_INCLUDE_INTERNATIONAL_SHIPPING=true
# "US", another single eBay region/country code, or "WORLDWIDE".
EBAY_SHIP_TO_REGION=WORLDWIDE
# Carrier-agnostic generic international rate class; eBay assigns
# shippingCarrierCode=GENERIC regardless of who actually carries it.
EBAY_INTERNATIONAL_SHIPPING_SERVICE=StandardInternational
# Set high enough to cover the priciest region in Printify's shipping.json
# profiles (its "REST_OF_THE_WORLD"/per-country buckets), since this is a
# single flat rate applied worldwide.
EBAY_SHIPPING_COST=14.99
# eBay defaults this to match EBAY_SHIPPING_COST if left unset, meaning
# every extra item in an order costs full price to ship. Set it to
# Printify's real "additional_items" cost from shipping.json so buying more
# of the same listing actually gets cheaper per item.
EBAY_ADDITIONAL_SHIPPING_COST=0.99

EBAY_RETURN_DAYS=30
EBAY_RETURN_SHIPPING_PAYER=BUYER

# Filled in by setup_account.py's output.
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

EBAY_AVAILABLE_QUANTITY=999
EBAY_PUBLISH=false
